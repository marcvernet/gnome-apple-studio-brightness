#!/usr/bin/env bash
# studio-display — manage the Apple Studio Display tear-free 5K mode on Linux.
#
# Background: this panel's TCON misbehaves at exactly 60.00 Hz / 936.000 MHz
# input (scroll tearing uncompressed; no sync with DSC). 1000 ppm under
# nominal — 59.94 Hz / 935.060 MHz, same link load — is flawless. A custom
# EDID (built by build_ladder.py) replaces the stock 5K@60.00 timing with
# 59.94 Hz (preferred) and adds 50/54/56/58 Hz, so the poison timing can
# never be selected — not even by mutter's preferred-mode fallback when an
# arrangement (e.g. "External only") has no saved monitors.xml entry. Forced DSC adds real
# bit depth (bpp 24-36, no FRC dithering) at ~40% link load, and is only
# safe on the sub-60 timings — this script enforces that.
#
# Usage:
#   studio-display status          what is running: mode, refresh, DSC, bpp, dither, link
#   studio-display dsc on|off      force DSC on/off — remembered; a timer re-converges
#                                  after mutter modesets (login/resume); --force bypasses guard
#   studio-display install         persist EDID via drm.edid_firmware + DSC convergence timer
#   studio-display uninstall       reverse install
set -u

CONNECTOR="${STUDIO_DISPLAY_CONNECTOR:-DP-2}"
EDID_NAME="apple-studio-display-5k-ladder.bin"
FWREF="edid/$EDID_NAME"
FW_PATH="/lib/firmware/edid/$EDID_NAME"
# MUST be connector-scoped ("DP-2:...") or eDP would get this EDID too
PARAM="drm.edid_firmware=${CONNECTOR}:${FWREF}"
UNIT="apple-studio-display-dsc.service"
TIMER="apple-studio-display-dsc.timer"
RULE="99-apple-studio-display.rules"
STATE_DIR="/var/lib/studio-display"
MARKER="$STATE_DIR/dsc"          # desired DSC state: "on" (default) or "off"
LOCK="/run/lock/studio-display.lock"
DSC_MAX_KHZ="${STUDIO_DISPLAY_DSC_MAX_KHZ:-935500}"  # above = exact-60 poison timing
BINDIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

die() { echo "studio-display: $*" >&2; exit 1; }

# ---- topology -------------------------------------------------------------
CARD=""
for d in /sys/class/drm/card*-"$CONNECTOR"; do [ -e "$d" ] && { CARD="${d##*/}"; break; }; done
[ -n "$CARD" ] || die "connector $CONNECTOR not found under /sys/class/drm (is the display plugged in?)"
DRMNO="${CARD#card}"; DRMNO="${DRMNO%%-*}"          # card1-DP-2 -> 1
INFO="/sys/kernel/debug/dri/$DRMNO/i915_display_info"
DBG="/sys/kernel/debug/dri/$DRMNO/$CONNECTOR"
SYSD="/sys/class/drm/$CARD"

need_root() {
    [ "$(id -u)" = 0 ] && return 0
    command -v pkexec >/dev/null 2>&1 && exec pkexec "$0" "$@"
    die "this command needs root"
}

# ---- parsing helpers (i915 debugfs + sysfs) --------------------------------
# Active 5K CRTC uapi line -> "clock htotal vtotal" (empty if 5K not active)
active_5k() {
    [ -r "$INFO" ] || return 0
    grep 'uapi:' "$INFO" 2>/dev/null | grep -m1 'mode="5120x2880": ' | grep 'active=yes' | awk '
        { for (i = 1; i <= NF; i++) if ($i ~ /^mode=/) { print $(i+2), $(i+6), $(i+10); exit } }'
}
refresh_hz() {  # "clock_kHz htot vtot" -> Hz (2dp)
    awk '{ printf "%.2f", $1 * 1000 / ($2 * $3) }' <<<"$1"
}
pipe_state() {  # -> "dither bpp" for the 5K pipe (order-insensitive)
    [ -r "$INFO" ] || return 0
    grep -m1 "src=5120x2880" "$INFO" 2>/dev/null | awk '
        match($0, /dither=[a-z]+/) { d = substr($0, RSTART+7, RLENGTH-7) }
        match($0, /bpp=[0-9]+/)    { b = substr($0, RSTART+4, RLENGTH-4) }
        END { if (d != "" && b != "") print d, b }'
}
link_state() {  # DP-2 connector block -> "port_clock lane_count"
    [ -r "$INFO" ] || return 0
    awk -v c="$CONNECTOR" '
        $0 ~ "\\[CONNECTOR:[0-9]+:" c "\\]" { f = 1; next }
        /^\[CONNECTOR:/ { if (f && pc != "" && lc != "") { print pc, lc; exit } f = 0 }
        f && match($0, /port_clock=[0-9]+/) { pc = substr($0, RSTART+11, RLENGTH-11) }
        f && match($0, /lane_count=[0-9]+/) { lc = substr($0, RSTART+11, RLENGTH-11) }
        END { if (f && pc != "" && lc != "") print pc, lc }' "$INFO"
}
yn() { [ "$1" = "yes" ] && echo "on" || echo "off"; }

# ---- status ----------------------------------------------------------------
cmd_status() {
    [ -r "$DBG/i915_dsc_fec_support" ] || need_root status
    echo "== Apple Studio Display (${CARD}, kernel $(uname -r)) =="

    local conn blocks edid
    conn=$(cat "$SYSD/status" 2>/dev/null || echo "?")
    blocks=$(od -An -tu1 -j126 -N1 "$SYSD/edid" 2>/dev/null | tr -d ' ')
    edid="stock"
    if [ "$(wc -c < "$DBG/edid_override" 2>/dev/null || echo 0)" -gt 0 ]; then
        edid="debugfs override (volatile)"
    elif [ -f "$FW_PATH" ]; then
        edid="firmware $FW_PATH"
    fi
    printf 'Connector   : %s   EDID: %s (%s extensions)\n' "$conn" "$edid" "${blocks:-?}"

    local a clock="" refresh="" pipe dither="" bpp="" dsc force link pc lc fw
    a=$(active_5k)
    if [ -n "$a" ]; then
        set -- $a
        clock=$1
        refresh=$(refresh_hz "$a")
        printf 'Mode        : 5120x2880 @ %s Hz  (clock %s kHz, htot %s, vtot %s)\n' \
            "$refresh" "$1" "$2" "$3"
    else
        printf 'Mode        : no active 5K mode on %s\n' "$CONNECTOR"
    fi

    pipe=$(pipe_state); dither=${pipe% *}; bpp=${pipe#* }
    [ -n "$pipe" ] && printf 'Pipe        : bpp %s, dither %s\n' "$bpp" "$dither"

    dsc=$(sed -n 's/^DSC_Enabled: //p' "$DBG/i915_dsc_fec_support" 2>/dev/null)
    force=$(sed -n 's/^Force_DSC_Enable: //p' "$DBG/i915_dsc_fec_support" 2>/dev/null)
    printf 'DSC         : %s (force flag: %s, desired: %s)\n' \
        "$(yn "${dsc:-no}")" "$(yn "${force:-no}")" "$(marker_get)"

    link=$(link_state); set -- $link; pc=${1:-}; lc=${2:-}
    case "${pc:-x}" in
        540000) pc=HBR2 ;; 810000) pc=HBR3 ;; 270000) pc=HBR ;; 162000) pc=RBR ;;
        0) [ -n "$clock" ] && pc="standby (idle)" || pc=down ;;
        *) pc="${pc:-?}" ;;
    esac
    printf 'Link        : %s x%s (SST)\n' "${pc:-?}" "${lc:-?}"

    fw=$(cat /sys/module/drm/parameters/edid_firmware 2>/dev/null)
    [ "$fw" = "(null)" ] && fw=""
    if [ -n "$fw" ]; then
        local psrc="(runtime only)"
        grep -q "$PARAM" /proc/cmdline 2>/dev/null && psrc="(kernel cmdline, persistent)"
        printf 'EDID param  : drm.edid_firmware=%s %s\n' "$fw" "$psrc"
    fi

    echo "-- verdict --"
    if [ -z "$clock" ]; then
        echo "  ⚠  5K not active"
    elif [ "$clock" -gt "$DSC_MAX_KHZ" ]; then
        echo "  ⚠  exact-60 Hz timing — known to tear on this panel."
        echo "     Fix: Settings → Displays → Studio Display → 5120 x 2880 (59.94 Hz),"
        echo "     or:  sudo studio-display dsc off   (then re-check)"
    else
        echo "  ✓  tear-free timing (clock ≤ ${DSC_MAX_KHZ} kHz)"
    fi
    if [ "${dsc:-no}" = yes ] && [ "$dither" = no ] && [ "${bpp:-0}" -ge 24 ] 2>/dev/null; then
        echo "  ✓  full bit depth via DSC (bpp $bpp) — no FRC dithering"
    elif [ "$bpp" = "18" ]; then
        echo "  ○  6-bit + FRC dithering (tear-free but banded gradients)."
        if [ "$(marker_get)" = on ]; then
            echo "     should self-heal within ~2 min (reconcile timer);"
            echo "     right now:  sudo studio-display dsc on"
        else
            echo "     re-enable:  sudo studio-display dsc on"
        fi
    fi
    if [ -z "$fw" ] && [ ! -f "$FW_PATH" ]; then
        echo "  ○  setup not persistent — sudo studio-display install"
    fi
    return 0
}

# ---- dsc -------------------------------------------------------------------
marker_get() { cat "$MARKER" 2>/dev/null || echo "on"; }   # default: on
marker_set() { mkdir -p "$STATE_DIR"; printf '%s' "$1" > "$MARKER"; }

dsc_field() {  # $1 = DSC_Enabled | Force_DSC_Enable
    sed -n "s/^$1: //p" "$DBG/i915_dsc_fec_support" 2>/dev/null
}
dsc_fully_on() {
    [ "$(dsc_field DSC_Enabled)" = yes ] && [ "$(dsc_field Force_DSC_Enable)" = yes ]
}

write_dsc() {  # $1 = 1|0 — write force flag + link retrain (retrain is what applies it)
    mkdir -p /run/lock
    (
        flock 9
        echo "$1" > "$DBG/i915_dsc_fec_support" &&
            echo 1 > "$DBG/i915_dp_force_link_retrain"
        sleep 3
    ) 9>"$LOCK"
}

dsc_guard() {  # 0 = safe to force DSC; else prints reason
    local a clock
    a=$(active_5k)
    [ -n "$a" ] || { echo "no active 5K mode on $CONNECTOR"; return 1; }
    clock=${a%% *}
    if [ "$clock" -gt "$DSC_MAX_KHZ" ]; then
        echo "active mode is ${clock} kHz (exact-60 timing): forced DSC blacks this panel."
        echo "Switch to 59.94 Hz in Settings first, or pass --force."
        return 1
    fi
    return 0
}

cmd_dsc() {  # $1=on|off [$2=--force] — manual toggle; records desired state
    local mode="$1" force="${2:-}" reason rc
    case "$mode" in on|off) ;; *) die "dsc takes 'on' or 'off'" ;; esac
    need_root dsc "$mode" ${force:+$force}

    if [ "$mode" = on ] && [ "$force" != --force ]; then
        rc=0; reason=$(dsc_guard) || rc=$?
        [ $rc -ne 0 ] && die "$reason"
    fi
    marker_set "$mode"
    write_dsc "$([ "$mode" = on ] && echo 1 || echo 0)"
    cmd_status
}

# Converge hardware to the desired state (marker). Runs from the boot/recurring
# systemd timer and the hotplug udev rule — mutter clears the force flag on
# every modeset (login, resume, replug), so we re-check instead of trusting one
# arming moment. Never touches the link when already converged; never arms on
# unsafe (exact-60) timings.
cmd_reconcile() {  # [--quiet] [--bg]
    local quiet="" bg="" a reason
    for a in "$@"; do
        case "$a" in
            --quiet) quiet=--quiet ;;
            --bg)    bg=1 ;;
            *) die "unknown reconcile option '$a'" ;;
        esac
    done
    need_root reconcile ${quiet:+$quiet} ${bg:+$bg}
    # udev RUN= must return fast: detach the worker (already root here)
    [ -n "$bg" ] && { setsid "$0" reconcile --quiet >/dev/null 2>&1 & exit 0; }

    case "$(marker_get)" in
        on)
            reason=$(dsc_guard) || {             # no 5K yet / unsafe (exact-60) timing
                [ -n "$reason" ] && logger -t studio-display "not arming: $reason"
                # DSC latched on the poison timing blacks the panel: cut it
                [ "$(dsc_field DSC_Enabled)" = yes ] && write_dsc 0
                exit 0
            }
            dsc_fully_on && exit 0
            write_dsc 1
            if [ "$(dsc_field DSC_Enabled)" = yes ]; then
                logger -t studio-display "DSC armed (reconcile)"
            else
                logger -t studio-display "DSC arm did not take (reconcile)"
            fi
            ;;
        off)
            [ "$(dsc_field Force_DSC_Enable)" = yes ] || exit 0
            write_dsc 0
            logger -t studio-display "DSC disarmed (reconcile)"
            ;;
    esac
    exit 0
}

# ---- install / uninstall ---------------------------------------------------
grub_file_ensure() {  # so future kernel installs inherit the param
    local f=/etc/default/grub v
    # drop any stale/legacy (unscoped) token, then append the correct one
    sed -i "s| drm\.edid_firmware=[^ \"]*||g" "$f"
    v=$(sed -n 's/^GRUB_CMDLINE_LINUX="\(.*\)"/\1/p' "$f" 2>/dev/null)
    sed -i "s|^GRUB_CMDLINE_LINUX=\"[^\"]*\"|GRUB_CMDLINE_LINUX=\"$v $PARAM\"|" "$f"
}

cmd_install() {
    need_root install
    [ -f "$FW_PATH" ] || [ -f "$BINDIR/edid/$EDID_NAME" ] || \
        die "EDID not found ($BINDIR/edid/$EDID_NAME). Run install from the repo's display/ directory."
    install -d -m0755 /lib/firmware/edid
    [ -f "$BINDIR/edid/$EDID_NAME" ] && install -m0644 "$BINDIR/edid/$EDID_NAME" "$FW_PATH"
    [ -f "$FW_PATH" ] || die "failed to install EDID to $FW_PATH"

    # self-install the CLI when run from a repo checkout
    [ "$BINDIR" != "/usr/local/bin" ] && install -m0755 "$(readlink -f "$0")" /usr/local/bin/studio-display
    chmod 0755 /usr/local/bin/studio-display 2>/dev/null || true   # systemd EXEC needs +x

    # desired state (default on); survives reinstalls
    mkdir -p "$STATE_DIR"; [ -f "$MARKER" ] || printf 'on' > "$MARKER"

    # mutter clears the DSC force flag on every modeset (login, resume), and a
    # cold-plugged panel fires no hotplug event — so instead of trusting one
    # arming moment, a timer re-converges hardware to $MARKER indefinitely.
    cat > "/etc/systemd/system/$UNIT" <<EOF
[Unit]
Description=Converge Apple Studio Display DSC to desired state

[Service]
Type=oneshot
ExecStart=/usr/local/bin/studio-display reconcile --quiet
EOF
    cat > "/etc/systemd/system/$TIMER" <<EOF
[Unit]
Description=Apple Studio Display DSC convergence check

[Timer]
OnBootSec=30s
OnUnitActiveSec=2min
AccuracySec=15s

[Install]
WantedBy=timers.target
EOF
    cat > "/etc/udev/rules.d/$RULE" <<EOF
# Re-converge DSC when the Studio Display is (re)plugged. --bg detaches.
SUBSYSTEM=="drm", KERNEL=="card*-$CONNECTOR", ACTION=="change", RUN+="/usr/local/bin/studio-display reconcile --quiet --bg"
EOF
    systemctl disable "$UNIT" >/dev/null 2>&1 || true   # drop legacy graphical.target enable
    systemctl daemon-reload
    systemctl enable --now "$TIMER" >/dev/null 2>&1
    udevadm control --reload-rules

    # EDID inside initramfs: i915 probes connectors from the initrd, where
    # /lib/firmware/edid doesn't exist -> early "*ERROR* Requesting EDID
    # firmware failed" (harmless: userspace probes reload it in real root,
    # but this makes it deterministic and silent from t=0).
    if command -v dracut >/dev/null 2>&1 && ! grep -qs "$EDID_NAME" /etc/dracut.conf.d/*edid*.conf; then
        printf 'install_items+=" %s "\n' "$FW_PATH" > /etc/dracut.conf.d/apple-studio-display-edid.conf
        dracut -f >/dev/null 2>&1 || true
    fi

    if command -v grubby >/dev/null 2>&1; then
        grubby --update-kernel=ALL --remove-args="drm.edid_firmware"   # clear stale values
        grubby --update-kernel=ALL --args="$PARAM"
    fi
    grub_file_ensure
    # live until reboot: firmware EDID for hotplug detects; drop debugfs override
    if [ -w /sys/module/drm/parameters/edid_firmware ]; then
        printf '%s' "${CONNECTOR}:${FWREF}" > /sys/module/drm/parameters/edid_firmware 2>/dev/null || true
    fi
    # exact 5-byte "reset" clears the override (drm debugfs edid_write handler)
    printf 'reset' > "$DBG/edid_override" 2>/dev/null || true

    echo "Installed:"
    echo "  EDID      : $FW_PATH (5K @ 50/54/56/58/59.94 Hz; stock 60.00 Hz removed)"
    echo "  boot param: $PARAM  (applies next boot; active now at runtime)"
    echo "  DSC arming: $TIMER (boot + every 2 min) + udev rule on replug"
    echo "              desired state in $MARKER — 'sudo studio-display dsc off' keeps it off"
    echo "GNOME keeps 59.94 Hz via ~/.config/monitors.xml. Verify after a reboot with:"
    echo "  studio-display status"
}

cmd_uninstall() {
    need_root uninstall
    echo 0 > "$DBG/i915_dsc_fec_support" 2>/dev/null || true
    echo 1 > "$DBG/i915_dp_force_link_retrain" 2>/dev/null || true
    printf 'reset' > "$DBG/edid_override" 2>/dev/null || true
    # "," parses to an empty connector list -> firmware EDID cleanly disabled
    printf ',' > /sys/module/drm/parameters/edid_firmware 2>/dev/null || true
    command -v grubby >/dev/null 2>&1 && grubby --update-kernel=ALL --remove-args="drm.edid_firmware"
    sed -i "s| drm\.edid_firmware=[^ \"]*||g" /etc/default/grub 2>/dev/null || true
    systemctl disable --now "$TIMER" >/dev/null 2>&1 || true
    systemctl disable --now "$UNIT" >/dev/null 2>&1 || true
    rm -f "/etc/systemd/system/$UNIT" "/etc/systemd/system/$TIMER" "/etc/udev/rules.d/$RULE"
    rm -rf "$STATE_DIR"
    if command -v dracut >/dev/null 2>&1 && ls /etc/dracut.conf.d/*apple-studio-display* >/dev/null 2>&1; then
        rm -f /etc/dracut.conf.d/*apple-studio-display*.conf
        dracut -f >/dev/null 2>&1 || true
    fi
    systemctl daemon-reload; udevadm control --reload-rules
    echo "Removed kernel param, timer, udev rule, desired-state marker. Stock EDID"
    echo "returns on next detect (replug or reboot). Optional cleanup:"
    echo "  sudo rm -f $FW_PATH /usr/local/bin/studio-display"
}

# ---- dispatch ---------------------------------------------------------------
usage() { sed -n '2,/^set -u/p' "$0" | sed '/^set -u/d; s/^# \{0,1\}//'; }

case "${1:-help}" in
    status) cmd_status ;;
    dsc)
        shift
        mode=""; force=""
        for a in "$@"; do
            case "$a" in
                on|off)   mode="$a" ;;
                --force)  force=--force ;;
                --quiet|--bg) ;;   # legacy no-ops: auto paths use 'reconcile' now
                *) die "unknown dsc option '$a'" ;;
            esac
        done
        cmd_dsc "${mode:-on}" "$force"
        ;;
    reconcile)
        shift
        cmd_reconcile "$@"
        ;;
    install)   cmd_install ;;
    uninstall) cmd_uninstall ;;
    help|--help|-h) usage ;;
    *) usage; exit 1 ;;
esac
